{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/studio/main.ts",
    "src/engine/api/*.ts",
    "src/engine/tools/solve-worker.ts",
    "bridge/bin.mjs",
    "bridge/src/cli.ts",
    "connectors/src/sdk.ts",
    "connectors/src/run.ts",
    "connectors/src/email/mime-worker.ts",
    "connectors/src/email/mime-worker.boot.mjs",
    "cli/*.mjs",
    "scripts/*.mjs",
    "scripts/*.ts",
    "tools/*.ts",
    "tools/studio/*.ts",
    "studio-server/src/ops/*.ts",
    "studio-server/src/server/main.ts",
    "tools/speedrun/*.ts",
    "tools/wiki/html-search.ts",
    "tests/**/*.test.ts",
    "tests/fixtures/connectors/no-eval-run.ts",
    "tests/fixtures/admit-child.ts",
    "tests/fixtures/runs-fake-worker.mjs",
    "tests/fixtures/**/index.ts",
    "games/*/index.ts",
    "games/*/e2e.mjs",
    "games/_template/**/*.ts",
    "vitest.mutation.config.ts",
    "src/engine/boot.ts"
  ],
  "project": [
    "src/**/*.ts",
    "bridge/src/**/*.ts",
    "connectors/src/**/*.ts",
    "studio-server/src/**/*.ts",
    "cli/**/*.mjs",
    "scripts/**",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "games/**/*.ts"
  ],
  "ignore": [
    "games/*/ending.config.example.ts",
    "games/signals/cast.ts",
    "src/studio/rooms.ts",
    "tests/fixtures/game-4.1/**"
  ],
  "ignoreDependencies": [
    "@tweakpane/core",
    "cpu-features",
    "nan",
    "pg"
  ],
  "ignoreBinaries": [
    "ffmpeg",
    "ffprobe",
    "openssl"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "duplicates": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "off"
  },
  "ignoreUnresolved": [
    "5"
  ]
}
