# The reference Bridge's image for the qualification profile (4.1.18, ops/qualify/README.md): built from the
# candidate's `quest-n-click-bridge` tarball (never from this checkout). 4.1.19 (plan §6.1): its dependencies, the Postgres
# peer and OpenTelemetry's API included, installed by `npm ci` from the image's versioned lock
# (scripts/locks/quest-n-click-bridge-image.json, written into the context by scripts/bridge-image.mjs) into /opt, where
# /opt/bridge/src/cli.mjs finds them as a parent folder's node_modules: nothing is resolved at build time.
FROM mirror.gcr.io/library/node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
WORKDIR /opt
COPY package.json package-lock.json /opt/
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npm cache clean --force
COPY quest-n-click-bridge.tgz /tmp/quest-n-click-bridge.tgz
RUN mkdir -p /opt/bridge \
 && tar -xzf /tmp/quest-n-click-bridge.tgz -C /opt/bridge --strip-components=1 \
 && rm /tmp/quest-n-click-bridge.tgz
WORKDIR /opt/bridge
ENTRYPOINT ["node", "/opt/bridge/bin.mjs"]
