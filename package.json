{
  "name": "jack-cherche-un-taf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "config": {
    "game": "jack"
  },
  "scripts": {
    "dev": "patch-package --error-on-fail && quest-n-click dev",
    "studio": "patch-package --error-on-fail && quest-n-click studio",
    "assets": "quest-n-click assets",
    "validate": "patch-package --error-on-fail && quest-n-click validate",
    "solve": "patch-package --error-on-fail && quest-n-click solve",
    "verify": "patch-package --error-on-fail && quest-n-click verify",
    "test": "patch-package --error-on-fail && vitest run",
    "build": "patch-package --error-on-fail && quest-n-click build",
    "release": "patch-package --error-on-fail && quest-n-click release",
    "preview": "quest-n-click preview",
    "i18n": "quest-n-click i18n",
    "cut-sheet": "python3 node_modules/@quest-n-click/engine/tools/cut-sheet.py --out game/art",
    "audio": "python3 node_modules/@quest-n-click/engine/tools/audio.py",
    "mcp": "quest-n-click mcp",
    "quest-n-click": "quest-n-click",
    "patch": "patch-package",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@quest-n-click/engine": "4.5.3"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "vitest": "^5.0.5"
  }
}
