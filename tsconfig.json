{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@quest-n-click/engine/*": [
        "./src/engine/api/*"
      ],
      "quest-n-click/*": [
        "./src/engine/api/*"
      ],
      "@engine/*": [
        "./src/engine/*"
      ],
      "@game": [
        "./.cache/game/index.ts",
        "./games/demo/index.ts"
      ],
      "@game/*": [
        "./.cache/game/*",
        "./games/demo/*"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "games",
    "tests",
    "tools",
    "scripts",
    "bridge",
    "connectors",
    "studio-server"
  ],
  "exclude": [
    "legacy",
    "node_modules",
    "dist",
    "tests/fixtures/game-4.1"
  ]
}
